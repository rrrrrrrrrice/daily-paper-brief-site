<td id="S6.T12.3.3.2" class="ltx_td ltx_align_justify ltx_align_top" style="padding-left:2.5pt;padding-right:2.5pt;">
<span id="S6.T12.3.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T12.3.3.2.1.1" class="ltx_p" style="width:108.4pt;">Regularization</span>
</span>
</td>
<td id="S6.T12.3.3.1" class="ltx_td ltx_nopad_r ltx_align_justify" style="padding-left:2.5pt;padding-right:2.5pt;">
<span id="S6.T12.3.3.1.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T12.3.3.1.1.1" class="ltx_p ltx_align_left"><math id="S6.T12.3.3.1.1.1.m1" class="ltx_Math" alttext="(\lambda_{\Phi},\lambda_{t})=(3\times 10^{-3},5\times 10^{-4})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi mathvariant="normal">Φ</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><mo>,</mo><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\lambda_{\Phi},\lambda_{t})=(3\times 10^{-3},5\times 10^{-4})</annotation></semantics></math>;
weighted penalties capped at 0.12 and 0.20 times the observation loss</span>
</span>
</td>
</tr>
<tr id="S6.T12.10.10" class="ltx_tr">
<td id="S6.T12.10.10.8" class="ltx_td ltx_align_justify ltx_align_top" style="padding-left:2.5pt;padding-right:2.5pt;">
<span id="S6.T12.10.10.8.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T12.10.10.8.1.1" class="ltx_p" style="width:108.4pt;">GP primitives</span>
</span>
</td>
<td id="S6.T12.10.10.7" class="ltx_td ltx_nopad_r ltx_align_justify" style="padding-left:2.5pt;padding-right:2.5pt;">
<span id="S6.T12.10.10.7.7" class="ltx_inline-block ltx_align_top">
<span id="S6.T12.10.10.7.7.7" class="ltx_p ltx_align_left">leaves <math id="S6.T12.4.4.1.1.1.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, free constants, and <math id="S6.T12.5.5.2.2.2.m2" class="ltx_Math" alttext="u^{p}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mi>p</mi></msup><annotation encoding="application/x-tex">u^{p}</annotation></semantics></math>,
<math id="S6.T12.6.6.3.3.3.m3" class="ltx_Math" alttext="p\in\{0.5,0.6,\ldots,3.0\}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0.5</mn><mo>,</mo><mn>0.6</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>3.0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">p\in\{0.5,0.6,\ldots,3.0\}</annotation></semantics></math>; operators
<math id="S6.T12.7.7.4.4.4.m4" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math>, <math id="S6.T12.8.8.5.5.5.m5" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>, <math id="S6.T12.9.9.6.6.6.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>, and protected division with sampling probabilities
<math id="S6.T12.10.10.7.7.7.m7" class="ltx_Math" alttext="(0.28,0.18,0.38,0.16)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0.28</mn><mo>,</mo><mn>0.18</mn><mo>,</mo><mn>0.38</mn><mo>,</mo><mn>0.16</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0.28,0.18,0.38,0.16)</annotation></semantics></math></span>
