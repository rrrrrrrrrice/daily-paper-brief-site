<td id="S5.T10.1.3.2.4" class="ltx_td ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;">5/5</td>
<td id="S5.T10.1.3.2.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;">5/5</td>
</tr>
<tr id="S5.T10.1.4.3" class="ltx_tr">
<th id="S5.T10.1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.4pt;padding-right:2.4pt;">DeepMoD</th>
<th id="S5.T10.1.4.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.4pt;padding-right:2.4pt;">KS-S100</th>
<td id="S5.T10.1.4.3.3" class="ltx_td ltx_align_center" style="padding-left:2.4pt;padding-right:2.4pt;">0/5</td>
