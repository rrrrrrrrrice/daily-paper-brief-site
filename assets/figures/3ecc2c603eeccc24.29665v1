<td id="S5.T10.1.5.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.4pt;padding-right:2.4pt;">–</td>
<td id="S5.T10.1.5.4.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:2.4pt;padding-right:2.4pt;">0/5</td>
