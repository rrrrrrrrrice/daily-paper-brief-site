<td id="Sx4.T3.2.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.4pt 1.5pt;"><math id="Sx4.T3.2.2.2.m1" class="ltx_Math" alttext="\hat{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{m}</annotation></semantics></math></td>
