<td id="S6.T11.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="S6.T11.1.1.1.m1" class="ltx_Math" alttext="0.100u^{1.727}+0.0002u^{2.727}-0.0001u+C" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>0.100</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>1.727</mn></msup></mrow><mo>+</mo><mrow><mn>0.0002</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2.727</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>0.0001</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>+</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">0.100u^{1.727}+0.0002u^{2.727}-0.0001u+C</annotation></semantics></math></td>
